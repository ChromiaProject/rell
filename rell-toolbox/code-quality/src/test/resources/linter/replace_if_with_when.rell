function multi_line(input: text): integer {
    if (input == 'a') {
        return 1;
    } else if (input == 'b') {
        return 2;
    } else {
        return 3;
    }
}

function single_line(x: integer) {
    if (x == 1) print('one'); else if (x == 2) print('two');
}

function no_chain(x: integer): integer {
    if (x > 0) return 1; else return 2;
}

function suppressed(input: text): integer {
    // rell-lint-disable-next-line
    if (input == 'a') { return 1; } else if (input == 'b') { return 2; } else { return 3; }
}

function expr_chain(a: integer): integer {
    val b = if (a == 1) 1 else if (a == 2) 0 else 3;
    return b;
}

function expr_chain_block_arm(a: integer): integer {
    return if (a == 1) { 1 } else if (a == 2) 2 else 3;
}

function expr_no_chain(a: integer): integer {
    return if (a > 0) 1 else 2;
}

function expr_suppressed(a: integer): integer {
    // rell-lint-disable-next-line
    return if (a == 1) 1 else if (a == 2) 0 else 3;
}

function stmt_block_kept(x: integer) {
    if (x == 1) {
        val y = x + 1;
        print(y);
    } else if (x == 2) {
        val z = x;
    } else {
        print(3);
    }
}

function expr_value_block_kept(a: integer): integer {
    return if (a == 1) { val b = a; b } else if (a == 2) 2 else 3;
}
