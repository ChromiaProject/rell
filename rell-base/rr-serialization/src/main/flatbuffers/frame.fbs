include "common.fbs";

namespace rell.ir;

/// Variable pointer within a call frame.
struct VarPtr {
    block_uid: uint;
    offset: int;
}

/// A block within a call frame (scoping unit).
/// Uids are signed: definitions with no init frame carry a -1 placeholder block.
table FrameBlock {
    parent_uid: int = null;  // null when this is a root block
    uid: int;
    offset: int;
    size: int;
}

/// Call frame descriptor. def_id is on the owning definition, not here.
table CallFrame {
    size: int;
    root_block: FrameBlock (required);
    has_guard_block: bool = false;
}
